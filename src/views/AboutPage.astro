---
import Base from '../layouts/Base.astro';
import { Content as En } from '../about/en.md';
import { Content as Es } from '../about/es.md';
import { site } from '../site';
import { ui, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<Base lang={lang} title={t.aboutTitle} description={t.aboutBlurb}>
  <article class="wrap page">
    <span class="glow lumo" style="--size: 28rem; right: -6rem; top: -4rem" aria-hidden="true"></span>
    <header>
      <h1>{t.tagline}</h1>
    </header>
    <div class="cols">
      <div class="prose">
        {lang === 'es' ? <Es /> : <En />}
        <p><a class="button" href={site.cv} target="_blank" rel="noopener">{t.cv}</a></p>
      </div>
    </div>
  </article>
</Base>

<style>
  /* The About page is set entirely in Helvetica Neue Light, like the project pages */
  .page, .page :global(*) { font-weight: 300; }
  .page { position: relative; padding-top: clamp(3rem, 8vw, 6rem); }
  .page > :not(.glow) { position: relative; z-index: 1; }
  h1 { font-size: var(--step-5); font-weight: 300; letter-spacing: -0.045em; line-height: 0.92; max-width: 10ch; margin-bottom: clamp(3rem, 7vw, 5rem); }
  .cols { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.5rem; }
  .prose { grid-column: 1 / 10; }
  .prose :global(p:first-child) { font-size: var(--step-2); font-weight: 300; line-height: 1.3; letter-spacing: -0.02em; }
  @media (max-width: 860px) {
    .prose { grid-column: 1 / -1; }
  }
</style>
