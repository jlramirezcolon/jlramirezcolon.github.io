---
// Photo gallery for a project, from a folder in src/assets/work/ (captions in src/data/galleries.ts).
// Works as a plain grid without JavaScript; with it, a photo opens larger in a dialog.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { galleries } from '../../data/galleries';
import { ui, type Lang } from '../../i18n';
interface Props { lang: Lang; folder: string }
const { lang, folder } = Astro.props;
const t = ui[lang].demo.gallery;
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/work/*/*.{jpg,JPG,jpeg,png}', { eager: true });
const photos = (galleries[folder] ?? [])
  .map((p) => ({ ...p, src: files[`../../assets/work/${folder}/${p.file}`]?.default }))
  .filter((p) => p.src);
---
{photos.length > 0 && (
  <figure class="gallery" data-gallery aria-label={t.label}>
    <ul role="list">
      {photos.map((p, i) => (
        <li>
          <button type="button" data-open={i} aria-label={`${t.open}: ${p[lang]}`}>
            <Image src={p.src!} alt={p[lang]} widths={[360, 720]} sizes="(max-width: 640px) 50vw, 340px" />
          </button>
          <span class="cap">{p[lang]}</span>
        </li>
      ))}
    </ul>
    <dialog class="viewer" aria-label={t.label}>
      <button type="button" class="close" data-close aria-label={t.close}>×</button>
      <button type="button" class="nav prev" data-step="-1" aria-label={t.prev}>←</button>
      <button type="button" class="nav next" data-step="1" aria-label={t.next}>→</button>
      {photos.map((p, i) => (
        <div class="slide" data-slide={i} hidden>
          <Image src={p.src!} alt={p[lang]} widths={[900, 1600]} sizes="90vw" loading="lazy" />
          <p>{p[lang]}</p>
        </div>
      ))}
    </dialog>
  </figure>
)}

<style>
  .gallery { margin: 2.5rem 0; }
  ul { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 0.9rem; }
  li { break-inside: avoid; margin: 0 0 1.1rem; }
  li > button { all: unset; display: block; width: 100%; cursor: zoom-in; border-radius: 4px; overflow: hidden; }
  li > button:focus-visible { outline: 2px solid var(--homo); outline-offset: 3px; }
  li :global(img) { display: block; width: 100%; height: auto; margin: 0; border-radius: 4px; transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); }
  li > button:hover :global(img) { transform: scale(1.02); }
  .cap { display: block; margin-top: 0.45rem; font-size: 0.875rem; line-height: 1.4; color: var(--slate); }

  .viewer {
    width: min(94vw, 1100px); max-height: 92vh; padding: 3rem 1rem 1rem; border: 0; border-radius: 8px;
    background: var(--paper); color: var(--ink);
  }
  .viewer::backdrop { background: rgba(10, 10, 20, 0.75); }
  .slide :global(img) { display: block; width: auto; max-width: 100%; max-height: 74vh; margin: 0 auto; border-radius: 4px; }
  .slide p { text-align: center; margin: 0.8rem auto 0; max-width: 60ch; font-size: 0.95rem; color: var(--slate); }
  .viewer button { font: inherit; cursor: pointer; background: transparent; border: 1px solid var(--rule); color: var(--ink); border-radius: 999px; width: 2.4rem; height: 2.4rem; }
  .viewer button:hover { border-color: var(--slate); }
  .close { position: absolute; top: 0.6rem; right: 0.6rem; font-size: 1.3rem; }
  .nav { position: absolute; top: 0.6rem; }
  .prev { left: 0.6rem; }
  .next { left: 3.4rem; }
  @media (max-width: 480px) { ul { columns: 1; } }
  @media (prefers-reduced-motion: reduce) { li :global(img) { transition: none; } }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const dialog = root.querySelector<HTMLDialogElement>('dialog')!;
    const slides = root.querySelectorAll<HTMLElement>('[data-slide]');
    let current = 0;
    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, k) => (s.hidden = k !== current));
    };
    root.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) =>
      b.addEventListener('click', () => { show(Number(b.dataset.open)); dialog.showModal(); }),
    );
    root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => show(current + Number(b.dataset.step))),
    );
    root.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
    });
  }
</script>
