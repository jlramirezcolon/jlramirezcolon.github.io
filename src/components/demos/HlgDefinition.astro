---
// LUMOS: dictionary-style entry for the HOMO-LUMO gap. Static, so it shows without JavaScript.
import { ui, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<aside class="definition" aria-label={t.defTerm}>
  <span class="glow homo" style="--size: 18rem; right: -4rem; top: -5rem" aria-hidden="true"></span>
  <p class="term">{t.defTerm}</p>
  <p class="label say"><span>{t.defSay}</span> <span>{t.defPos}</span></p>
  <p class="def">{t.defText}</p>
</aside>

<style>
  .definition { position: relative; margin: 3rem 0; padding: 2rem 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .definition > p { position: relative; z-index: 1; }
  .term { font-size: var(--step-3); letter-spacing: -0.035em; line-height: 1.05; margin: 0 0 1rem; }
  .say { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; margin: 0 0 1.5rem; text-transform: none; }
  .say span:last-child { text-transform: uppercase; }
  .def { font-size: var(--step-1); line-height: 1.4; letter-spacing: -0.01em; max-width: 36ch; margin: 0; }
</style>
