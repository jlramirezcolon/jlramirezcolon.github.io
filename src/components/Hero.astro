---
// Home hero: portrait, headline, and a short intro over a slowly turning spiral galaxy.
import { Image } from 'astro:assets';
import portrait from '../assets/work/profile-pic.jpg';
import { ui, href, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<section class="hero">
  <canvas class="galaxy" aria-hidden="true"></canvas>
  <div class="wrap inner">
    <figure class="portrait">
      <Image src={portrait} alt={t.portraitAlt} widths={[360, 640, 960]} sizes="(max-width: 860px) 70vw, 420px" loading="eager" fetchpriority="high" />
    </figure>
    <div class="text">
      <h1 class="title">{t.heroTitle}</h1>
      <p class="greeting">{t.heroGreeting}</p>
      <p class="intro">{t.heroIntro}</p>
      <a class="button" href={href(lang, '/about/')}>{t.learnMore} →</a>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; }
  .galaxy {
    position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none;
    /* Fade out toward the bottom so the hero melts into the page. */
    -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent);
    mask-image: linear-gradient(to bottom, #000 70%, transparent);
  }
  .inner {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.5rem; align-items: center;
    min-height: min(90vh, 880px);
    padding-top: clamp(2.5rem, 6vw, 4rem); padding-bottom: clamp(3rem, 7vw, 5rem);
  }
  .portrait { grid-column: 1 / 5; margin: 0; }
  .portrait :global(img) {
    width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover;
    border-radius: 999px 999px 10px 10px; /* an arch */
  }
  .text { grid-column: 6 / 13; }
  .title {
    font-size: clamp(2.4rem, 5.2vw, 4.6rem); font-weight: 300;
    letter-spacing: -0.04em; line-height: 1; margin-bottom: 2rem; max-width: 15ch;
  }
  .greeting { font-size: var(--step-1); line-height: 1.4; margin-bottom: 0.75rem; max-width: 36ch; }
  .intro { font-size: 1.15rem; font-weight: 300; line-height: 1.55; color: var(--slate); max-width: 44ch; margin-bottom: 2rem; }

  @media (prefers-reduced-motion: no-preference) {
    .portrait, .title, .greeting, .intro, .button { animation: rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
    .title { animation-delay: 0.1s; }
    .greeting { animation-delay: 0.22s; }
    .intro { animation-delay: 0.3s; }
    .button { animation-delay: 0.38s; }
    .galaxy { animation: fade 2.4s ease both; }
    @keyframes rise { from { opacity: 0; transform: translateY(0.6rem); } }
    @keyframes fade { from { opacity: 0; } }
  }

  @media (max-width: 860px) {
    .inner { min-height: 0; row-gap: 2rem; }
    .portrait, .text { grid-column: 1 / -1; }
    .portrait { max-width: 17rem; }
  }
</style>

<script>
  // A two-armed spiral galaxy seen at an angle, turning slowly. Drawn in the site's own colors:
  // ink stars with a few cobalt and amber ones, around a soft core.
  const canvas = document.querySelector<HTMLCanvasElement>('.hero .galaxy');
  if (canvas) init(canvas);

  function init(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    type Star = { r: number; a: number; size: number; tone: 0 | 1 | 2; alpha: number; tw: number };
    let W = 0, H = 0, stars: Star[] = [], field: { x: number; y: number; s: number; tw: number }[] = [];
    let angle = 0;
    const colors: Record<string, string> = {};
    const readColors = () => {
      const cs = getComputedStyle(document.documentElement);
      for (const k of ['ink', 'homo', 'lumo']) colors[k] = cs.getPropertyValue(`--${k}`).trim();
    };
    readColors();
    const recolor = () => { readColors(); draw(performance.now()); };
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', recolor);
    document.addEventListener('themechange', recolor);

    const gauss = () => (Math.random() + Math.random() + Math.random() - 1.5) / 1.5;
    function build() {
      const area = W * H;
      const n = Math.round(Math.min(1400, Math.max(500, area / 900)));
      const rMax = Math.max(W, H) * 0.62;
      stars = Array.from({ length: n }, () => {
        const arm = Math.random() < 0.5 ? 0 : Math.PI;
        const u = Math.pow(Math.random(), 0.75);
        const r = 14 + u * rMax;
        // Logarithmic spiral arms, with scatter that loosens toward the edge.
        const a = arm + Math.log(r / 14) / 0.32 + gauss() * (0.35 + 0.25 * u);
        const roll = Math.random();
        return { r, a, size: 0.5 + Math.random() * (u < 0.15 ? 1.1 : 1.5), tone: roll < 0.1 ? 1 : roll < 0.17 ? 2 : 0, alpha: 0.25 + Math.random() * 0.5, tw: Math.random() * 6.28 };
      });
      field = Array.from({ length: Math.round(area / 9000) }, () => ({ x: Math.random() * W, y: Math.random() * H, s: 0.4 + Math.random() * 0.9, tw: Math.random() * 6.28 }));
    }

    // The galaxy's center sits behind the portrait on wide screens, higher up on narrow ones.
    const center = () => (W > 860 ? { x: W * 0.27, y: H * 0.48 } : { x: W * 0.5, y: H * 0.22 });
    const tilt = 0.48, skew = -0.35; // view angle and orientation of the disk

    function draw(time: number) {
      ctx.clearRect(0, 0, W, H);
      const { x: cx, y: cy } = center();
      const cosS = Math.cos(skew), sinS = Math.sin(skew);

      // Soft core: amber at the heart, a cobalt halo around it.
      const core = ctx.createRadialGradient(cx, cy, 0, cx, cy, Math.max(W, H) * 0.32);
      core.addColorStop(0, hexA(colors.lumo, 0.22));
      core.addColorStop(0.35, hexA(colors.homo, 0.08));
      core.addColorStop(1, hexA(colors.homo, 0));
      ctx.fillStyle = core;
      ctx.fillRect(0, 0, W, H);

      for (const f of field) {
        ctx.globalAlpha = 0.16 + 0.14 * Math.sin(time * 0.0012 + f.tw);
        ctx.fillStyle = colors.ink;
        ctx.fillRect(f.x, f.y, f.s, f.s);
      }
      for (const s of stars) {
        const a = s.a + angle;
        const x0 = Math.cos(a) * s.r, y0 = Math.sin(a) * s.r * tilt;
        const x = cx + x0 * cosS - y0 * sinS, y = cy + x0 * sinS + y0 * cosS;
        if (x < -4 || x > W + 4 || y < -4 || y > H + 4) continue;
        ctx.globalAlpha = s.alpha * (0.8 + 0.2 * Math.sin(time * 0.002 + s.tw));
        ctx.fillStyle = s.tone === 1 ? colors.homo : s.tone === 2 ? colors.lumo : colors.ink;
        ctx.beginPath(); ctx.arc(x, y, s.size, 0, Math.PI * 2); ctx.fill();
      }
      ctx.globalAlpha = 1;
    }

    function hexA(color: string, a: number) {
      const m = color.match(/^#([0-9a-f]{6})$/i);
      if (!m) return color;
      const v = parseInt(m[1], 16);
      return `rgba(${v >> 16}, ${(v >> 8) & 255}, ${v & 255}, ${a})`;
    }

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas.clientWidth; H = canvas.clientHeight;
      if (!W || !H) return;
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      build(); draw(performance.now());
    }
    new ResizeObserver(resize).observe(canvas);

    // One full turn every four minutes; paused when off-screen or when motion is reduced.
    let visible = false, running = false, last = 0;
    function frame(now: number) {
      angle += ((now - last) / 1000) * ((Math.PI * 2) / 240);
      last = now;
      draw(now);
      if (visible && !reduce.matches) requestAnimationFrame(frame); else running = false;
    }
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !running && !reduce.matches) { running = true; last = performance.now(); requestAnimationFrame(frame); }
    }).observe(canvas);
  }
</script>
